{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.anonymizer.tsbuildinfo",
		"skipLibCheck": true,
		"noEmit": true,
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "bun"],
		"strict": true
	},
	"include": ["anonymizer/**/*.ts"]
}
