{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["src/main.tsx", "src/background.ts", "vite.config.ts", "vite-plugin-api.ts"],
	"framework": [
		{
			"name": "testserver",
			"enablers": ["hono"],
			"entryPoints": ["testserver/src/app.ts"],
			"entryPointRole": "support"
		}
	],
	"ignorePatterns": [".cursor/**"],
	"ignoreExportsUsedInFile": true,
	"ignoreExports": [
		{
			"file": "testserver/src/api/**",
			"exports": ["*"]
		}
	],
	"rules": {
		"unused-files": "error",
		"unused-exports": "warn",
		"circular-dependencies": "warn"
	},
	"health": {
		"maxCrap": 500
	}
}
