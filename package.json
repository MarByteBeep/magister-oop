	},
	"type": "module",
	"scripts": {
		"dev": "bun run vite",
		"build": "bun test && bun run check && bunx vite build && bun run check",
		"preview": "vite preview",
		"format": "bunx @biomejs/biome format --write",
		"check": "bunx @biomejs/biome check --write",
		"check:fallow": "bunx fallow dead-code --format json --quiet --ci",
		"check:ci": "bunx @biomejs/biome ci && bunx tsc -b --noEmit && bun run check:fallow && echo 'no errors'",
		"testserver:init": "bun run ./testserver/src/init/init.ts",
		"anon": "bun run ./anonymizer/index.ts"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.8",
		"apexcharts": "^5.3.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"deepmerge": "^4.3.1",
		"fallow": "^3.22.0",
		"lz-string": "^1.5.0",
		"react": "^19.2.4",
		"react-apexcharts": "^1.9.0",
		"react-big-calendar": "^1.19.4",
		"react-dom": "^19.2.4",
		"react-icons": "^5.5.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.18",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@faker-js/faker": "^8.4.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.4.0",
		"@types/chrome": "^0.1.36",
		"@types/node": "^24.10.9",
		"@types/react": "^19.2.10",
		"@types/react-big-calendar": "^1.16.3",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.1.2",
		"dotenv": "^17.2.3",
		"hono": "^4.6.0",
		"typescript": "^7.0.2",
		"vite": "^7.3.1",
		"vite-plugin-static-copy": "^3.2.0"
	}
