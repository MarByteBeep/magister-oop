{
	"compilerOptions": {
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["../src/*"],
			"@data/*": ["./data/*"]
		},
		"strict": true,
		"types": ["node", "bun", "chrome"],
		"forceConsistentCasingInFileNames": true
	},
	"include": ["./**/*.ts", "../src/**/*"]
}
